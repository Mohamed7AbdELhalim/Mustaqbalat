{
  "manifest_version": 3,
  "name": "مستقبلات للراحة البصرية | Mustaqbalat",
  "short_name": "مستقبلات",
  "version": "1.0.0",
  "description": "أداة خفيفة تعمل افتراضياً لتقليل أو زيادة سطوع الشاشة، طبقات التعتيم، الوضع الداكن، تلوين الشاشة HEX، دعم ملفات PDF، ومراقبة الاستهلاك مع ربط GitHub.",
  "default_locale": "ar",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "مستقبلات للراحة البصرية — التحكم بالسطوع والألوان والاستهلاك",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "core/mustaqbalat-engine.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "options_page": "pages/dashboard.html",
  "web_accessible_resources": [
    {
      "resources": [
        "pages/dashboard.html",
        "pages/pdf-viewer.html",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mustaqbalat@visual-comfort.org",
      "strict_min_version": "109.0"
    }
  }
}
